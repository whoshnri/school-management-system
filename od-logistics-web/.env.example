# Square coverage boundary (UK latitude/longitude)
COVERAGE_MIN_LAT=51.28
COVERAGE_MAX_LAT=51.70
COVERAGE_MIN_LNG=-0.52
COVERAGE_MAX_LNG=0.33

# Public values for initial map rendering in the browser
NEXT_PUBLIC_COVERAGE_MIN_LAT=51.28
NEXT_PUBLIC_COVERAGE_MAX_LAT=51.70
NEXT_PUBLIC_COVERAGE_MIN_LNG=-0.52
NEXT_PUBLIC_COVERAGE_MAX_LNG=0.33

# Ignore secondary geocode provider if it differs by more than this threshold
MAX_GEOCODE_DEVIATION_KM=1

# Optional fallback geocode providers
GOOGLE_GEOCODING_API_KEY=
NOMINATIM_USER_AGENT=od-logistics-web/0.1 (your-email@example.com)

# Initial map viewport
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=10
